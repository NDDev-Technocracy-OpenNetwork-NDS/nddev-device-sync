{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "nddev-device-sync module manifest",
  "type": "object",
  "required": [
    "id",
    "version",
    "api_version",
    "kind",
    "platforms",
    "capabilities",
    "permissions",
    "dependencies"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "api_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "kind": {
      "enum": [
        "gds",
        "rds",
        "tool",
        "accounts",
        "integration"
      ]
    },
    "platforms": {
      "type": "array",
      "items": {
        "enum": [
          "macos",
          "linux",
          "windows",
          "android",
          "ios",
          "web"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "capabilities": {
      "type": "array",
      "items": {
        "enum": [
          "read_device_state",
          "manage_device_state",
          "run_existing_tool",
          "manage_harness_accounts",
          "switch_harness_account",
          "read_module_health",
          "apply_updates",
          "share_clipboard"
        ]
      },
      "uniqueItems": true
    },
    "permissions": {
      "type": "array",
      "items": {
        "enum": [
          "read_only",
          "credential_store",
          "process_execution",
          "local_network",
          "user_service",
          "clipboard",
          "git_write"
        ]
      },
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "minimum_api"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "minimum_api": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
