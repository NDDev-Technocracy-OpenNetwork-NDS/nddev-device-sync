{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NDS repository catalog",
  "type": "object",
  "required": [
    "$schema",
    "catalog_version",
    "product",
    "license",
    "organization",
    "channel",
    "modules"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "module-catalog.schema.json"
    },
    "catalog_version": {
      "const": 1
    },
    "product": {
      "const": "nddev-device-sync"
    },
    "license": {
      "const": "AGPL-3.0-only"
    },
    "organization": {
      "const": "NDDev-Technocracy-OpenNetwork-NDS"
    },
    "channel": {
      "enum": [
        "alpha",
        "beta",
        "release"
      ]
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "repository",
          "kind",
          "status",
          "platforms"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,127}$"
          },
          "repository": {
            "type": "string",
            "pattern": "^nddev-[a-z0-9-]+$"
          },
          "kind": {
            "enum": [
              "shared-core",
              "contracts",
              "server",
              "agent",
              "flutter-client",
              "web-client",
              "service",
              "module",
              "adapter",
              "self-hosting-engine",
              "design-system"
            ]
          },
          "status": {
            "enum": [
              "future",
              "alpha",
              "beta",
              "release"
            ]
          },
          "platforms": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "linux",
                "macos",
                "windows",
                "android",
                "ios",
                "web",
                "all"
              ]
            }
          }
        }
      }
    }
  }
}
