{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nddev.ai/schemas/nds/app-release/1",
  "title": "NDS first-alpha Linux application staging candidate",
  "description": "Authenticate these exact bytes as the attested subject before consumption. Publisher trust belongs to assembly policy. Exact data versions grant staging only, never activation or a migration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "application",
    "version",
    "platform",
    "architecture",
    "channel",
    "sources",
    "data",
    "artifact"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "application": {
      "const": "nds"
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.0\\.0-alpha\\.([1-9][0-9]{0,8}|[1-3][0-9]{9}|4[01][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[01][0-9]{2}|42949672[0-8][0-9]|429496729[0-5])(?![\\s\\S])",
      "$comment": "Decimal alternatives cover exactly 1..u32::MAX, matching the Core candidate parser and semantic validator."
    },
    "platform": {
      "const": "linux"
    },
    "architecture": {
      "enum": [
        "x86_64",
        "aarch64"
      ]
    },
    "channel": {
      "const": "alpha"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "repository",
          "commit"
        ],
        "properties": {
          "repository": {
            "type": "string",
            "maxLength": 222,
            "pattern": "^https://github\\.com/[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}(?![\\s\\S])"
          },
          "commit": {
            "$ref": "#/$defs/commit"
          },
          "role": {
            "type": "string",
            "pattern": "^[a-z0-9_.-]{1,64}(?![\\s\\S])"
          }
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vault_journal",
        "sync_wire",
        "accounts_fence"
      ],
      "properties": {
        "vault_journal": {
          "$ref": "#/$defs/format"
        },
        "sync_wire": {
          "$ref": "#/$defs/format"
        },
        "accounts_fence": {
          "$ref": "#/$defs/format"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "bytes",
        "sha256",
        "app_source",
        "native_source"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https?://[^\\s]+(?![\\s\\S])",
          "maxLength": 2048
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "app_source": {
          "$ref": "#/$defs/commit"
        },
        "native_source": {
          "$ref": "#/$defs/commit"
        }
      }
    }
  },
  "$defs": {
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}(?![\\s\\S])"
    },
    "format": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    }
  }
}
